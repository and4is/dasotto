@page "/login"
@using dasotto.Utils
@using dasotto.Components.Sections 

@rendermode InteractiveServer
@inject Microsoft.Extensions.Configuration.IConfiguration config
@inject NavigationManager NavigationManager

@if (isAuthenticated)
{
<Settings />
    <button type="button" @onclick="Logout" class="btn btn-primary mt-3">Logout</button>
}
else
{
    <div class="login-container">
        <form class="login-form">
            <h2>Login</h2>
            <label for="username">Username</label>
            <input type="text" id="username" @bind="Username" placeholder="Enter username" class="form-control" required />

            <label for="password">Password</label>
            <input type="password" id="password" @bind="Password" placeholder="Enter password" class="form-control" required />

            <!-- Bootstrap Alert für Fehlermeldungen -->
            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <div class="alert alert-danger mt-3" role="alert">
                    @ErrorMessage
                </div>
            }

            <button type="button" @onclick="OnLogin" class="btn btn-primary mt-3">Login</button>
        </form>
    </div>
}

@code {
    private string Username { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private bool isAuthenticated = false;
    private string ErrorMessage = string.Empty;

    // Brute-Force-Schutz
    private int failedAttempts = 0;
    private const int maxAttempts = 5;
    private DateTime lockoutEndTime = DateTime.MinValue;
    private TimeSpan lockoutDuration = TimeSpan.FromMinutes(5);

    private DateTime LoginTimeStart{ get; set; }

    private async Task OnLogin()
    {
        // Überprüfe, ob das Konto gesperrt ist
        if (DateTime.Now < lockoutEndTime)
        {
            ErrorMessage = $"Account is locked. Please try again after {lockoutEndTime.ToString("HH:mm:ss")}.";
            return;
        }

        // Überprüfen der Anmeldeinformationen aus appsettings.json
        string adminUserName = config["AdminUserName"];
        string hashedAdminPassword = config["AdminPassword"];
        bool isValidUser = string.Equals(Username, adminUserName, StringComparison.OrdinalIgnoreCase);
        bool isPasswordMatch = PasswordSystem.VerifyPassword(Password, hashedAdminPassword);

        if (isValidUser && isPasswordMatch)
        {
            // Authentifizierung erfolgreich, Zugriff gewähren
            isAuthenticated = true;
            ErrorMessage = string.Empty;
            failedAttempts = 0; // Reset bei erfolgreicher Anmeldung
        }
        else
        {
            // Fehlgeschlagene Authentifizierung
            failedAttempts++;
            ErrorMessage = "Invalid Username or Password";

            // Wenn max. Anzahl an Versuchen überschritten ist, Konto sperren
            if (failedAttempts >= maxAttempts)
            {
                lockoutEndTime = DateTime.Now.Add(lockoutDuration);
                ErrorMessage = $"Too many failed attempts. Account is locked until {lockoutEndTime.ToString("HH:mm:ss")}.";
            }
        }

        StateHasChanged();
    }

    private void Logout()
    {
        // Benutzer abmelden und Seite neu laden
        isAuthenticated = false;
        Username = string.Empty;
        Password = string.Empty;
        NavigationManager.NavigateTo("/", forceLoad: true);
    }
}

<style>
    .login-container {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100vh;
        background-color: #000;
    }

    .login-form {
        width: 100%;
        max-width: 400px;
        padding: 2rem;
        background-color: #fff;
        border-radius: 8px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

        .login-form h2 {
            margin-bottom: 1rem;
            font-size: 24px;
            color: #333;
        }

        .login-form label {
            display: block;
            margin-top: 1rem;
            font-weight: bold;
            color: #555;
        }

        .login-form input[type="text"],
        .login-form input[type="password"] {
            width: 100%;
            padding: 0.75rem;
            margin-top: 0.5rem;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-sizing: border-box;
            font-size: 16px;
        }

        .login-form button {
            width: 100%;
            padding: 0.75rem;
            margin-top: 1.5rem;
            background-color: #007bff;
            border: none;
            border-radius: 4px;
            color: #fff;
            font-size: 18px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

            .login-form button:hover {
                background-color: #0056b3;
            }
</style>
